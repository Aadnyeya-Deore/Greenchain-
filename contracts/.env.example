# Copy to .env — NEVER commit .env. Use a fresh wallet that only holds testnet funds.
DEPLOYER_PRIVATE_KEY=
MST_RPC_URL=https://testnetrpc.mstblockchain.com

# Optional deployment parameters
# Admin receives DEFAULT_ADMIN_ROLE (defaults to the deployer). Prefer a separate/multisig address on real networks.
ADMIN_ADDRESS=
# Optional: grant VERIFIER_ROLE at deploy time (only works when the deployer is also the admin)
VERIFIER_ADDRESS=
# Delay (seconds) before an admin transfer can be accepted
ADMIN_TRANSFER_DELAY=86400
# kg CO2e minted per verified tree
CREDITS_PER_TREE=22
# How long verified credits stay valid, in days
VALIDITY_DAYS=3650
